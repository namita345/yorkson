# Public frontend configuration (do not add server secrets with VITE_ prefix)
VITE_CONTACT_ENDPOINT=

# Dedicated serverless contact form — must be set in Vercel, NOT exposed as VITE_ values
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Yorkson Academy <enquiries@your-verified-domain.com>
CONTACT_TO_EMAIL=care@yorksonchildcare.com

# GOOGLE BUSINESS / GOOGLE PLACES (Vercel server-side ONLY)
# Recommended to activate first: use Places API (New) with an API key + Place ID.
# Do NOT add any of these with the VITE_ prefix; never commit real secrets.
GOOGLE_CONTENT_MODE=places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# OPTIONAL: To display a wider selection of owner-authorized photos and reviews,
# request Google Business Profile API access, obtain owner-approved OAuth 2.0.
# Set GOOGLE_CONTENT_MODE=owner (or auto to try owner then Places).
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
