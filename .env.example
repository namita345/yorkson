# Public frontend configuration (do not add server secrets with VITE_ prefix)
VITE_CONTACT_ENDPOINT=

# Dedicated serverless contact form — must be set in Vercel, NOT exposed as VITE_ values
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Yorkson Academy <enquiries@your-verified-domain.com>
CONTACT_TO_EMAIL=care@yorksonchildcare.com

# OPTIONAL — Google Business Profile (owner photo feed)
# Requires authorized access to the correct Yorkson listing and API access approval.
# Set these SERVER-side in Vercel Environment Variables; never commit actual secrets.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# ALTERNATIVE — Places API (New), up to 10 public Google place photos
# Requires Google Cloud billing + Places API (New) enabled.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
